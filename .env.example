# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored - never commit real credentials.

# Supabase Postgres - pooled connection (pgbouncer, port 6543).
# Used by the app at runtime. Find it in Supabase: Project Settings > Database
# > Connection string > "Transaction" pooling mode, with `?pgbouncer=true` appended.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Supabase Postgres - direct connection (port 5432).
# Used only by `prisma migrate` (migrations don't work through the pooler).
# Find it in Supabase: Project Settings > Database > Connection string > "Session" mode.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Seed (bootstrap) user credentials - used only by `npm run seed:user`
# (scripts/seed-user.ts), never read by the running app. Set to a real
# email/strong password before first setup, then rotate the password
# immediately after first login using the seed user's own reset route.
SEED_USER_EMAIL="admin@example.com"
SEED_USER_PASSWORD="change-me-before-first-run"

# HMAC signing key for session cookies (lib/auth.ts). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates all existing sessions.
SESSION_SECRET="replace-with-a-random-32-byte-hex-string"

# LLM provider for Q&A / intake assistance (lib/llm). Defaults to Gemini's free tier.
# Get a free key at https://aistudio.google.com/apikey
# Switch provider by changing LLM_PROVIDER to "openai" or "anthropic" and setting that key.
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# Optional overrides:
# LLM_MODEL="gemini-3.6-flash"
# LLM_TIMEOUT_MS="25000"

# Database capacity shown on the admin Storage page (Supabase free tier = 500 MB)
DB_CAPACITY_MB="500"
